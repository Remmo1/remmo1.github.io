---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section
  id="portfolio"
  class="border-b border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-8">
    <h2 class="text-3xl font-bold tracking-tight">Portfolio</h2>

    <div class="space-y-8">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>


