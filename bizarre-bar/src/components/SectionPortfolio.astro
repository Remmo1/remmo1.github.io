---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---

<section
  id="portfolio"
  class="border-b border-slate-200 dark:border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-8">
    <h2 class="text-3xl font-bold tracking-tight">
      {t(locale, 'nav.portfolio')}
    </h2>

    <div class="space-y-8">
      {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </div>
</section>


