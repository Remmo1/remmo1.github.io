---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
---

<article
  class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-start rounded-xl border border-slate-200 dark:border-slate-800 bg-white/30 dark:bg-slate-900/50 p-5"
>
  <div class="space-y-3">
    <h3
      id={project.id === 'covidTracker' ? project.id : undefined}
      class="text-xl font-semibold text-slate-900 dark:text-slate-50"
    >
      {project.title}
    </h3>
    <p class="text-sm text-sky-600 dark:text-sky-400">
      {project.stack}
    </p>
    <div class="flex flex-wrap gap-3">
      {
        project.links.map((link) => (
          <a
            class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-200 hover:text-sky-400 transition-colors"
            href={link.href}
          >
            {
              link.type === 'youtube' && (
                <i class="fab fa-youtube"></i>
              )
            }
            {
              link.type === 'github' && (
                <i class="fab fa-github"></i>
              )
            }
            {link.type === 'other' && (
              <i class="fas fa-link"></i>
            )}
            <span>{link.label}</span>
          </a>
        ))
      }
    </div>
    <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
      {project.description}
    </p>
  </div>
  <div class="text-sm text-sky-400 whitespace-nowrap">
    {project.badge}
  </div>
</article>

