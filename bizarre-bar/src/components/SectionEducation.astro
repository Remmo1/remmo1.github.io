---
import { education } from '../data/education';
---

<section
  id="education"
  class="border-b border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-8">
    <h2 class="text-3xl font-bold tracking-tight">Edukacja</h2>

    {
      education.map((entry) => (
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
        >
          <div class="space-y-1">
            <h3 class="text-xl font-semibold">{entry.school}</h3>
            {entry.degree && (
              <p class="text-sm text-sky-400">{entry.degree}</p>
            )}
            {entry.faculty && (
              <p class="text-sm text-slate-300">{entry.faculty}</p>
            )}
            {entry.field && (
              <p class="text-sm text-slate-300">{entry.field}</p>
            )}
          </div>
          <div class="text-sm text-sky-400 whitespace-nowrap">
            {entry.period}
          </div>
        </div>
      ))
    }
  </div>
</section>


