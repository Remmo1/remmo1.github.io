---
interface Props {
  href: string;
  label: string;
  /**
   * Optional Font Awesome class to render an <i> element. If omitted, the
   * component will render whatever is passed through the default slot instead.
   */
  iconClass?: string;
}

const { href, label, iconClass } = Astro.props as Props;
---

<a
  class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-slate-100 hover:bg-sky-500 dark:hover:bg-sky-500 hover:text-white dark:hover:text-white transition-colors"
  href={href}
  aria-label={label}
>
  {iconClass ? <i class={iconClass}></i> : <slot />}
