---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---
<section
  id="skills"
  class="border-b border-slate-200 dark:border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-8">
    <!-- translated heading -->
    <h2 class="text-3xl font-bold tracking-tight">
      {t(locale, 'nav.skills')}
    </h2>

    <div class="space-y-4">
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">
        {t(locale, 'skills.languagesHeading')}
      </h3>
      <ul class="flex flex-wrap gap-4 text-3xl text-sky-400">
        <li><i class="fab fa-java" aria-hidden="true"></i></li>
        <li><i class="fab fa-html5" aria-hidden="true"></i></li>
        <li><i class="fab fa-css3-alt" aria-hidden="true"></i></li>
        <li><i class="fab fa-js-square" aria-hidden="true"></i></li>
        <li><i class="fab fa-react" aria-hidden="true"></i></li>
        <li><i class="fab fa-node-js" aria-hidden="true"></i></li>
        <li><i class="fab fa-ubuntu" aria-hidden="true"></i></li>
        <li><i class="fab fa-npm" aria-hidden="true"></i></li>
        <li><i class="fab fa-android" aria-hidden="true"></i></li>
        <li><i class="fab fa-python" aria-hidden="true"></i></li>
      </ul>
    </div>

    <div class="space-y-3">
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">
        {t(locale, 'skills.otherHeading')}
      </h3>
      <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-300">
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-sky-400">
            <i class="fas fa-check"></i>
          </span>
          <span>Spring boot, Hibernate</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-sky-400">
            <i class="fas fa-check"></i>
          </span>
          <span>Kotlin, Scala</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-sky-400">
            <i class="fas fa-check"></i>
          </span>
          <span>Intelij, Visual Studio Code</span>
        </li>
      </ul>
    </div>
  </div>
</section>

