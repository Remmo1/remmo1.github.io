---
import { experience } from '../data/experience';
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---

<section
  id="experience"
  class="border-b border-slate-200 dark:border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-8">
    <h2 class="text-3xl font-bold tracking-tight">
      {t(locale, 'nav.experience')}
    </h2>

    {
      experience.map((entry) => (
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
        >
          <div class="space-y-2">
            <h3 class="text-xl font-semibold">{entry.company[locale]}</h3>
            <p class="text-sm text-sky-400">{entry.role[locale]}</p>
            <p class="text-sm text-slate-700 dark:text-slate-300">
              {entry.description[locale]}
            </p>
          </div>
          <div class="text-sm text-sky-400 whitespace-nowrap">
            {entry.period[locale]}
          </div>
        </div>
      ))
    }
  </div>
</section>

