            href="/certificates/RemigiuszPisarski-2122z_sk1_sr0915-certificate_ciscoSignature.pdf"
            download="RemigiuszPisarski-2122z_sk1_sr0915-certificate"
            class="inline-flex items-center gap-2 hover:text-sky-400 transition-colors"
