---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---
<section
  id="interests"
  class="border-b border-slate-200 dark:border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-6">
    <h2 class="text-3xl font-bold tracking-tight">
      {t(locale, 'nav.interests')}
    </h2>
    <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
      {t(locale, 'interests.p1')}
    </p>
    <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
      {t(locale, 'interests.p2')}
    </p>
  </div>
</section>

