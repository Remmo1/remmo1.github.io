---
import profileImg from '../assets/img/profile.jpg';
---

<nav
  id="sideNav"
  class="lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 bg-slate-900/90 backdrop-blur border-r border-slate-800 flex lg:flex-col items-center lg:items-stretch px-4 py-4 lg:py-8 z-20"
>
  <a
    href="#page-top"
    class="flex items-center gap-3 text-slate-100 lg:flex-col lg:gap-4"
  >
    <span class="lg:hidden font-semibold tracking-wide">
      Remigiusz Pisarski
    </span>
    <span class="hidden lg:block">
      <img
        src={profileImg.src}
        alt="Zdjęcie Remigiusza Pisarskiego"
        class="h-28 w-28 rounded-full object-cover mx-auto ring-2 ring-slate-700 shadow-lg"
      />
    </span>
  </a>

  <ul
    class="ml-auto lg:ml-0 flex flex-row lg:flex-col gap-4 lg:gap-3 text-sm font-medium text-slate-200 tracking-wide"
  >
    <li>
      <a
        href="#about"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Główna</a
      >
    </li>
    <li>
      <a
        href="#education"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Wykształcenie</a
      >
    </li>
    <li>
      <a
        href="#experience"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Doświadczenie</a
      >
    </li>
    <li>
      <a
        href="#skills"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Umiejętności</a
      >
    </li>
    <li>
      <a
        href="#portfolio"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Portfolio</a
      >
    </li>
    <li>
      <a
        href="#interests"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Zainteresowania</a
      >
    </li>
    <li>
      <a
        href="#awards"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-800 hover:text-white transition-colors"
        >Certyfikaty</a
      >
    </li>
  </ul>
</nav>

