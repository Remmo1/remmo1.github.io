---
import profileImg from '../assets/img/photo.png';
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---

<nav
  id="sideNav"
  class="lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-r border-slate-200 dark:border-slate-800 flex lg:flex-col items-center lg:items-stretch px-4 py-4 lg:py-8 z-20 text-slate-900 dark:text-slate-100"
>
  <a
    href="#page-top"
    class="flex items-center gap-3 text-slate-900 dark:text-slate-100 lg:flex-col lg:gap-4"
  >
    <span class="lg:hidden font-semibold tracking-wide">
      Remigiusz Pisarski
    </span>
    <span class="hidden lg:block">
      <img
        src={profileImg.src}
        alt="Zdjęcie Remigiusza Pisarskiego"
        class="h-28 w-28 rounded-full object-cover mx-auto ring-2 ring-slate-700 shadow-lg"
      />
    </span>
  </a>

  <ul
    class="ml-auto lg:ml-0 flex flex-row lg:flex-col gap-4 lg:gap-3 text-sm font-medium text-slate-900 dark:text-slate-200 tracking-wide"
  >
    <li>
      <a
        href="#about"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.home')}</a
      >
    </li>
    <li>
      <a
        href="#education"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.education')}</a
      >
    </li>
    <li>
      <a
        href="#experience"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.experience')}</a
      >
    </li>
    <li>
      <a
        href="#skills"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.skills')}</a
      >
    </li>
    <li>
      <a
        href="#portfolio"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.portfolio')}</a
      >
    </li>
    <li>
      <a
        href="#interests"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.interests')}</a
      >
    </li>
    <li>
      <a
        href="#awards"
        class="px-3 py-1.5 rounded-full lg:rounded-md hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >{t(locale, 'nav.awards')}</a
      >
    </li>
  </ul>

  <div class="mt-6 flex flex-col items-center gap-4">
    <!-- language switch -->
    <a
      href={locale === 'pl' ? '/en' : '/pl'}
      class="px-3 py-1.5 rounded-full border hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors"
    >
      {locale === 'pl' ? t(locale, 'button.switchToEnglish') : t(locale, 'button.switchToPolish')}
    </a>

    <button
      onclick="toggleTheme()"
      class="p-2 rounded-full hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors"
      aria-label="Toggle light/dark mode"
    >
      <!-- sun visible in light mode, hide in dark -->
      <svg class="w-5 h-5 block dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M6.05 17.95l-1.414 1.414M18.364 18.364l-1.414-1.414M6.05 6.05L4.636 4.636" />
      </svg>
      <!-- moon visible in dark mode -->
      <svg class="w-5 h-5 hidden dark:block" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M21 12.79A9 9 0 0111.21 3 7 7 0 0012 21a9 9 0 009-8.21z" />
      </svg>
    </button>
  </div>
</nav>

