---
import SocialIconLink from './SocialIconLink.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---

<section
  id="about"
  class="border-b border-slate-200 dark:border-slate-800 pb-12 scroll-mt-24 lg:scroll-mt-8"
>
  <div class="max-w-4xl space-y-6">
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight"
    >
      Remigiusz
      <span class="text-sky-400">Pisarski</span>
    </h1>

    <div class="flex flex-wrap items-center gap-3 text-sm text-slate-700 dark:text-slate-300">
      <a
        href="mailto:remigiusz.pisarski@onet.pl"
        class="underline underline-offset-4 decoration-sky-500 hover:text-white"
      >
        remigiusz.pisarski@onet.pl
      </a>
      <span class="text-slate-500 dark:text-slate-600">•</span>
      <span>Wrocław, Polska</span>
    </div>

    <p class="text-base sm:text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      {t(locale, 'about.description')}
    </p>

    <div class="flex items-center gap-4 pt-2">
      <SocialIconLink
        href="https://www.linkedin.com/in/remigiusz-pisarski-5a6154248/"
        label="LinkedIn"
        iconClass="fab fa-linkedin"
      />
      <SocialIconLink
        href="https://github.com/Remmo1"
        label="GitHub"
        iconClass="fab fa-github"
      />
      <SocialIconLink
        href="https://x.com/Remmo123456789"
        label="X"
      >
        <!-- simple X logo SVG pulled from FontAwesome 6 or custom source -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-5 w-5"
        >
          <path d="M23.298 4.155a1.37 1.37 0 0 0-1.062-.467 1.37 1.37 0 0 0-.976.426L12 13.402 2.74 4.114a1.371 1.371 0 0 0-1.948 1.925l9.256 9.333-9.256 9.333a1.371 1.371 0 1 0 1.948 1.925L12 16.483l9.32 9.347a1.37 1.37 0 0 0 1.948-1.925l-9.256-9.333 9.256-9.333a1.37 1.37 0 0 0 .04-1.403z"/>
        </svg>
      </SocialIconLink>
      <SocialIconLink
        href="https://www.facebook.com/profile.php?id=100007905436766"
        label="Facebook"
        iconClass="fab fa-facebook-f"
      />
    </div>
  </div>
</section>


