---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import SectionAbout from '../components/SectionAbout.astro';
import SectionEducation from '../components/SectionEducation.astro';
import SectionExperience from '../components/SectionExperience.astro';
import SectionSkills from '../components/SectionSkills.astro';
import SectionPortfolio from '../components/SectionPortfolio.astro';
import SectionInterests from '../components/SectionInterests.astro';
import SectionAwards from '../components/SectionAwards.astro';
import { t } from '../i18n';
import type { Locale } from '../i18n';

// build two variants: root (pl) and /en (en)
export async function getStaticPaths() {
  return [
    { params: { lang: 'pl' }, props: { locale: 'pl' }, pathname: '/' },
    { params: { lang: 'en' }, props: { locale: 'en' }, pathname: '/en' },
  ];
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const isEn = locale === 'en';

const title = t(locale, 'meta.title');
const description = t(locale, 'meta.description');
---

<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content={description} />
    <link rel="alternate" href={isEn ? '/pl' : '/en'} hreflang={isEn ? 'pl' : 'en'} />
    <meta name="author" content="Remigiusz Pisarski" />
    <title>{title}</title>

    <!-- theme initializer (runs before paint, sets html.dark if needed) -->
    <script>
      (function() {
        const stored = localStorage.getItem('theme');
        if (
          stored === 'dark' ||
          (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      })();
      window.toggleTheme = function() {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
          html.classList.remove('dark');
          localStorage.theme = 'light';
        } else {
          html.classList.add('dark');
          localStorage.theme = 'dark';
        }
      };
    </script>

    <!-- Open Graph / social sharing -->
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description}
    />
    <meta property="og:image" content="/assets/img/photo.png" />
    <meta property="og:url" content="https://remmo1.github.io/" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Google Fonts (optional, can be replaced with Tailwind font utilities) -->
    <link
      href="https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700"
      rel="stylesheet"
      type="text/css"
    />
    <link
      href="https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i"
      rel="stylesheet"
      type="text/css"
    />

    <!-- Font Awesome icons -->
    <script
      src="https://use.fontawesome.com/releases/v5.15.4/js/all.js"
      crossorigin="anonymous"
      defer
    ></script>
    <script
      src="https://kit.fontawesome.com/7070b0c049.js"
      crossorigin="anonymous"
      defer
    ></script>
  </head>

  <body
    id="page-top"
    class="min-h-screen bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased"
  >
    <div class="flex flex-col lg:flex-row">
      <!-- Sidebar / Nav -->
      <Sidebar locale={locale} />

      <!-- Page Content -->
      <main
        class="w-full lg:ml-72 px-4 sm:px-8 lg:px-16 py-10 lg:py-16 space-y-16"
      >
        <SectionAbout locale={locale} />
        <SectionEducation locale={locale} />
        <SectionExperience locale={locale} />
        <SectionSkills locale={locale} />
        <SectionPortfolio locale={locale} />
        <SectionInterests locale={locale} />
        <SectionAwards locale={locale} />
      </main>
    </div>
  </body>
</html>
